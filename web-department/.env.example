# Web Department — Environment
ENVIRONMENT=development

# Database — default is SQLite at data/web-department.db
# Switch to Postgres later by setting: DATABASE_URL=postgresql+psycopg://user:pass@host/db
# DATABASE_URL=

# RemotePay backend (SimplyBlu is the official payment path)
REMOTEPAY_API_URL=http://127.0.0.1:8000
REMOTEPAY_API_VERSION=v1
REMOTEPAY_MODE=auto

# Ubernie Delivery (waitlist-driven; in-process)
UBERNIE_DELIVERY_API_URL=

# Tax AI
TAXAI_API_URL=http://127.0.0.1:8600

# Public URL where generated sites call this API
WEB_DEPARTMENT_PUBLIC_URL=http://127.0.0.1:8100

# Waitlist thresholds
WAITLIST_MIN_SHOPS=15
WAITLIST_MIN_RIDERS=3

# Where generated sites are written
GENERATED_SITES_DIR=generated-sites

# SQL echo (set to 1 for verbose query logs)
SQL_ECHO=0
