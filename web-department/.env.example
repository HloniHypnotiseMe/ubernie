# Web Department — Environment
ENVIRONMENT=development

# RemotePay backend
REMOTEPAY_API_URL=http://127.0.0.1:8000
REMOTEPAY_API_VERSION=v1
# Set to "mock" to force mock mode (for local dev without RemotePay running)
REMOTEPAY_MODE=auto

# Ubernie Delivery engine (optional for now)
UBERNIE_DELIVERY_API_URL=http://127.0.0.1:8500

# Tax AI (optional for now)
TAXAI_API_URL=http://127.0.0.1:8600

# Public URL where generated sites will call this API
WEB_DEPARTMENT_PUBLIC_URL=http://127.0.0.1:8100
