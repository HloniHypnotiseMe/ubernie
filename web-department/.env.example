# Web Department — Environment
ENVIRONMENT=development

# RemotePay backend (SimplyBlu is the official payment path)
REMOTEPAY_API_URL=http://127.0.0.1:8000
REMOTEPAY_API_VERSION=v1
# Set to "mock" to force mock mode (for local dev without RemotePay running)
REMOTEPAY_MODE=auto

# Ubernie Delivery engine (waitlist-driven; in-process for now)
UBERNIE_DELIVERY_API_URL=

# Tax AI (optional for now)
TAXAI_API_URL=http://127.0.0.1:8600

# Public URL where generated sites will call this API
# In dev this is your local web-department; in prod it's the public API host.
WEB_DEPARTMENT_PUBLIC_URL=http://127.0.0.1:8100

# Waitlist thresholds (used to decide when a zone activates)
WAITLIST_MIN_SHOPS=15
WAITLIST_MIN_RIDERS=3

# Where generated sites are written to
GENERATED_SITES_DIR=/var/www/c6-sites
