# Ubernie Web Department — production-safe environment contract
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8100

# Database — SQLite for local development; PostgreSQL is required for production.
DATABASE_URL=sqlite:///data/web-department.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/ubernie

# RemotePay — production MUST use live; no automatic mock fallback.
REMOTEPAY_API_URL=http://127.0.0.1:8000
REMOTEPAY_API_VERSION=v1
REMOTEPAY_MODE=auto
REMOTEPAY_WEBHOOK_SECRET=

# JWT — production must be a unique secret.
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRE_MINUTES=1440

# Browser origins allowed to call the API. Comma-separated.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8100,http://localhost:8100

# Public URL where generated sites call this API.
WEB_DEPARTMENT_PUBLIC_URL=http://127.0.0.1:8100

# Waitlist thresholds
WAITLIST_MIN_SHOPS=15
WAITLIST_MIN_RIDERS=3

# Where generated sites are written
GENERATED_SITES_DIR=generated-sites

# Tax AI
TAXAI_API_URL=http://127.0.0.1:8600

# Delivery
UBERNIE_DELIVERY_API_URL=

SQL_ECHO=0
