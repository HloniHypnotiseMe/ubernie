    {"parameters":{"method":"POST","url":"https://api.whatsapp.com/send","sendBody":true,"bodyParameters":{"parameters":{"to":"={{ $json.driver_phone }}","message":"New delivery assignment: {{ $("Delivery Request").item.json.body.pickup }} → {{ $("Delivery Request").item.json.body.dropoff }}"}}},"id":"notify","name":"Notify Driver","type":"n8n-nodes-base.httpRequest","typeVersion":4,"position":[850,300]},
    {"parameters":{"respondWith":"json","responseBody":"={\"status\":\"dispatched\",\"driver_id\":\"{{ $json.driver_id }}\"}"},"id":"res","name":"Respond","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1050,300]}
