  "connections":{"Delivery Request":{"main":[[{"node":"Find Drivers","type":"main","index":0}]]},"Find Drivers":{"main":[[{"node":"AI Match","type":"main","index":0}]]},"AI Match":{"main":[[{"node":"Notify Driver","type":"main","index":0}]]},"Notify Driver":{"main":[[{"node":"Respond","type":"main","index":0}]]}}
