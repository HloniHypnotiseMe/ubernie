    {"parameters":{"operation":"executeQuery","query":"SELECT * FROM drivers WHERE status = 'available' AND city_id = '{{$json.body.city_id}}' ORDER BY rating DESC LIMIT 3" },"id":"find","name":"Find Drivers","type":"n8n-nodes-base.postgres","typeVersion":2,"position":[450,300]},
